    {
      "name": "Filter Button",
      "kind": "button",
      "refersTo": "filter-button",
      "description": "Summary button in the filter bar; opens a floating panel.",
      "html": "<button class=\"ds-fb\" aria-expanded=\"false\"><span class=\"ds-k\">Mix</span><span class=\"ds-v\">90 / 10</span><svg viewBox=\"0 0 12 12\" aria-hidden=\"true\"><path d=\"M3 4.5 6 7.5 9 4.5\"/></svg></button>",
      "css": ".ds-fb{--ink:#141413;--ink-2:#5b5a56;--ink-3:#6f6d68;--surface:#fff;--hover:#f3f2ef;--rule:#e9e8e4;--rule-strong:#d6d4ce;display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 10px 0 12px;border:1px solid var(--rule-strong);border-radius:999px;background:var(--surface);color:var(--ink);font:400 13px/1 Geist,system-ui,sans-serif;cursor:pointer;transition:background .15s,border-color .15s}.ds-fb:hover{background:var(--hover)}.ds-fb[aria-expanded=true]{background:var(--hover);border-color:var(--ink-3)}.ds-fb:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.ds-k{color:var(--ink-3)}.ds-v{font-weight:500;font-variant-numeric:tabular-nums}.ds-fb svg{width:12px;height:12px;fill:none;stroke:var(--ink-3);stroke-width:1.6;stroke-linecap:round}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Two-to-three option switch for chart settings.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Coding</button><button aria-pressed=\"false\">Intelligence</button></div>",
      "css": ".ds-seg{--ink:#141413;--ink-2:#5b5a56;--ink-3:#6f6d68;--surface:#fff;--hover:#f3f2ef;--rule:#e9e8e4;--rule-strong:#d6d4ce;display:inline-flex;padding:3px;border-radius:8px;background:var(--hover);border:1px solid var(--rule)}.ds-seg button{appearance:none;border:0;background:transparent;color:var(--ink-2);font:500 13px/1 Geist,system-ui,sans-serif;padding:7px 12px;border-radius:6px;cursor:pointer;transition:background .15s,color .15s}.ds-seg button:hover{color:var(--ink)}.ds-seg button[aria-pressed=true]{background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgb(0 0 0/.06),0 0 0 1px var(--rule)}.ds-seg button:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Provider Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Toggle for one provider, with its swatch and model count.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\" style=\"--c:#eb6834\"><span class=\"ds-sw\"></span>Anthropic<span class=\"ds-n\">12</span></button><button class=\"ds-chip\" aria-pressed=\"false\" style=\"--c:#2a78d6\"><span class=\"ds-sw\"></span>OpenAI<span class=\"ds-n\">13</span></button>",
      "css": ".ds-chip{--ink:#141413;--ink-2:#5b5a56;--ink-3:#6f6d68;--surface:#fff;--hover:#f3f2ef;--rule:#e9e8e4;--rule-strong:#d6d4ce;display:inline-flex;align-items:center;gap:8px;margin:2px;border:1px solid var(--rule-strong);background:var(--surface);color:var(--ink);font:400 13px/1 Geist,system-ui,sans-serif;padding:7px 12px 7px 10px;border-radius:999px;cursor:pointer}.ds-chip:hover{background:var(--hover)}.ds-chip:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.ds-sw{width:8px;height:8px;border-radius:50%;background:var(--c)}.ds-n{font:400 11px/1 'Geist Mono',ui-monospace,monospace;color:var(--ink-3)}.ds-chip[aria-pressed=false]{background:transparent;color:var(--ink-3);border-style:dashed}.ds-chip[aria-pressed=false] .ds-sw{background:transparent;box-shadow:inset 0 0 0 1.5px var(--ink-3)}"
    },
    {
      "name": "Step Navigation",
      "kind": "nav",
      "refersTo": "step-rail",
      "description": "The five detail pages as numbered steps with their questions.",
      "html": "<ol class=\"ds-steps\"><li><a href=\"#\"><span class=\"n\">1</span><span class=\"t\">Cost</span><span class=\"q\">What does a model cost?</span></a></li><li><a href=\"#\" aria-current=\"page\"><span class=\"n\">2</span><span class=\"t\">Budget</span><span class=\"q\">What does my budget buy?</span></a></li><li><a href=\"#\"><span class=\"n\">3</span><span class=\"t\">Value</span><span class=\"q\">Which model is worth it?</span></a></li></ol>",
      "css": ".ds-steps{--ink:#141413;--ink-2:#5b5a56;--ink-3:#6f6d68;--surface:#fff;--hover:#f3f2ef;--rule:#e9e8e4;--rule-strong:#d6d4ce;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:2px;margin:0;padding:3px;list-style:none;background:var(--hover);border:1px solid var(--rule);border-radius:12px}.ds-steps a{display:grid;grid-template-columns:auto 1fr;column-gap:8px;row-gap:3px;align-items:baseline;padding:8px 12px 9px;border:1px solid transparent;border-radius:9px;color:var(--ink-2);text-decoration:none;transition:background .15s,color .15s}.ds-steps a:hover{color:var(--ink)}.ds-steps a:focus-visible{outline:2px solid var(--ink);outline-offset:2px}.ds-steps .n{font:500 11px/1 'Geist Mono',monospace;color:var(--ink-3)}.ds-steps .t{font:500 13px/1 Geist,system-ui,sans-serif}.ds-steps .q{grid-column:2;font:400 12px/1.3 Geist,system-ui,sans-serif;color:var(--ink-3)}.ds-steps a[aria-current=page]{background:var(--surface);color:var(--ink);border-color:var(--rule-strong);box-shadow:0 1px 2px rgb(0 0 0/.06)}"
